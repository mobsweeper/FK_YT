<Window x:Class="FkYouTube.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FkYouTube" xmlns:controls="clr-namespace:FkYouTube.Controls" xmlns:playback="clr-namespace:FkYouTube.Playback" Title="FK_YT" FontFamily="Segoe UI, Malgun Gothic, Yu Gothic UI, Meiryo" Icon="/Assets/fk-yt.ico" Width="1380" Height="900" MinWidth="1080" MinHeight="640" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Window.Resources>
  <Style x:Key="PlayerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="PlayerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerButtonStyle}"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="7"/></Style>
  <Style x:Key="PlayerComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
   <Setter Property="MinWidth" Value="70"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="Padding" Value="8,5"/></Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#292E3B" BorderBrush="#465169" BorderThickness="1" CornerRadius="5"/></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Margin="7,4,22,4" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
    <TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,7,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#242936" BorderBrush="#465169" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320"><ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <local:VideoCardDetailConverter x:Key="VideoCardDetailConverter"/>
  <local:ChannelNameConverter x:Key="ChannelNameConverter"/>
  <local:LocalizedFormatConverter x:Key="LikeTooltipFormat" Ko="선택한 YouTube 채널로 좋아요 · 다시 누르면 취소&#10;{0}" En="Like with the selected YouTube channel · Click again to remove&#10;{0}" Ja="選択した YouTube チャンネルで高評価・もう一度押すと取り消し&#10;{0}"/>
  <local:LocalizedFormatConverter x:Key="DislikeTooltipFormat" Ko="선택한 YouTube 채널로 싫어요 · 다시 누르면 취소&#10;{0}&#10;수치 제공: Return YouTube Dislike · ≈ 추정치&#10;{1}" En="Dislike with the selected YouTube channel · Click again to remove&#10;{0}&#10;Counts: Return YouTube Dislike · ≈ estimates&#10;{1}" Ja="選択した YouTube チャンネルで低評価・もう一度押すと取り消し&#10;{0}&#10;件数提供: Return YouTube Dislike・≈ 推定値&#10;{1}"/>
  <local:LocalizedFormatConverter x:Key="RatingRefreshTooltipFormat" Ko="YouTube에 저장된 내 평가 확인&#10;{0}" En="Check my rating saved on YouTube&#10;{0}" Ja="YouTube に保存された自分の評価を確認&#10;{0}"/>
  <local:LocalizedFormatConverter x:Key="DislikeStatsTooltipFormat" Ko="영상 ID로 수치를 조회합니다. 로그인 쿠키는 전달하지 않습니다.&#10;수치 제공: Return YouTube Dislike · 오른쪽 클릭: 공식 사이트&#10;{0}" En="Look up counts by video ID without sending sign-in cookies.&#10;Counts: Return YouTube Dislike · Right-click: official site&#10;{0}" Ja="動画 ID で件数を取得します。ログイン Cookie は送信しません。&#10;件数提供: Return YouTube Dislike・右クリック: 公式サイト&#10;{0}"/>
  <Style x:Key="SubtitleMenuStyle" TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="#242936" BorderBrush="#465169" BorderThickness="1" CornerRadius="5" Padding="4"><ScrollViewer MaxHeight="344" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ChannelLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="4,3"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ToolTip" Value="{local:Loc Ko='채널 영상 보기', En='View channel videos', Ja='チャンネルの動画を見る'}"/></Style>
  <Style x:Key="FeedFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,0,8,0"/><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="#445A8C"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid x:Name="LayoutRoot" Background="{StaticResource Bg}" TextElement.FontFamily="Segoe UI, Malgun Gothic, Yu Gothic UI, Meiryo" TextElement.FontSize="14" TextElement.Foreground="#F0F2F8">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Background="#171A22" Padding="18,25,14,18">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,30"><TextBlock Text="FK / YT" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="{local:Loc Ko='가볍게, 필요한 것만', En='Lightweight. Just what you need.', Ja='軽く、必要なものだけ'}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{local:Loc Ko='YouTube 채널', En='YouTube channel', Ja='YouTube チャンネル'}" Foreground="{StaticResource Muted}" FontSize="11"/><ComboBox x:Name="ChannelCombo" SelectionChanged="Channel_Changed" Margin="0,8,0,8" ToolTip="{local:Loc Ko='같은 Google 계정의 채널 전환', En='Switch channels within this Google account', Ja='同じ Google アカウントのチャンネルを切り替え'}"/><Button x:Name="ReloadChannelsButton" Content="{local:Loc Ko='채널 목록 갱신', En='Refresh channels', Ja='チャンネル一覧を更新'}" Click="ReloadChannels_Click" FontSize="12"/><CheckBox x:Name="IncognitoCheck" Content="{local:Loc Ko='시크릿 모드', En='Incognito mode', Ja='シークレット モード'}" Checked="Incognito_Changed" Unchecked="Incognito_Changed" ToolTip="{local:Loc Ko='로그인 쿠키와 시청 기록·이어보기 저장을 사용하지 않습니다.', En='Do not use sign-in cookies or save watch history and playback positions.', Ja='ログイン Cookie を使用せず、視聴履歴と再生位置を保存しません。'}"/><TextBlock x:Name="AccountLabel" Text="{local:Loc Ko='로그인 연결 안 됨', En='Not connected', Ja='ログイン未接続'}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{local:Loc Ko='NATIVE YOUTUBE VIEWER', En='NATIVE YOUTUBE VIEWER', Ja='ネイティブ YouTube ビューアー'}" FontSize="9" Foreground="#67738D" Margin="0,12,0,0"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel>
     <Button x:Name="HomeButton" Content="{local:Loc Ko='홈 추천', En='Home', Ja='ホーム'}" Tag="home" Click="Nav_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
     <Button Content="Shorts" Tag="shorts" Click="Nav_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
     <Button Content="{local:Loc Ko='구독', En='Subscriptions', Ja='登録チャンネル'}" Tag="subscriptions" Click="Nav_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
     <Button Content="{local:Loc Ko='재생목록', En='Playlists', Ja='再生リスト'}" Tag="playlists" Click="Nav_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
     <Button Content="{local:Loc Ko='나중에 볼 영상', En='Watch later', Ja='後で見る'}" Tag="watchlater" Click="Nav_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
     <Button Content="{local:Loc Ko='시청 기록', En='Watch history', Ja='視聴履歴'}" Tag="localhistory" Click="Nav_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
     <Button x:Name="SettingsButton" Content="{local:Loc Ko='설정 · 로그인', En='Settings · Sign in', Ja='設定・ログイン'}" Tag="settings" Click="Nav_Click" HorizontalContentAlignment="Left" Margin="0,20,0,8"/>
     <TextBlock Text="{local:Loc Ko='표시 언어', En='Display language', Ja='表示言語'}" Foreground="{StaticResource Muted}" FontSize="11" Margin="3,8,0,0"/>
     <ComboBox x:Name="UiLanguageCombo" SelectionChanged="UiLanguage_Changed" Margin="0,6,0,0" FontSize="13" ToolTip="{local:Loc Ko='앱 화면의 언어만 변경합니다.', En='Change the app display language only.', Ja='アプリの表示言語のみ変更します。'}" AutomationProperties.Name="{local:Loc Ko='표시 언어', En='Display language', Ja='表示言語'}"><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="한국어" Tag="ko"/><ComboBoxItem Content="日本語" Tag="ja"/></ComboBox>
    </StackPanel></ScrollViewer>
   </DockPanel>
  </Border>
  <Grid x:Name="MainContent" Grid.Column="1" Margin="24,20,24,14">
   <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="Header" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="SearchBox" ToolTip="{local:Loc Ko='검색어 또는 YouTube 영상·채널·재생목록 주소', En='Search or enter a YouTube video, channel or playlist URL', Ja='検索語または YouTube の動画・チャンネル・再生リストの URL'}" KeyDown="Search_KeyDown" VerticalContentAlignment="Center"/>
    <Button Grid.Column="1" Content="{local:Loc Ko='검색 / 열기', En='Search / Open', Ja='検索 / 開く'}" Click="Search_Click" Margin="10,0,8,0"/><Button Grid.Column="2" Content="{local:Loc Ko='새로고침', En='Refresh', Ja='更新'}" Click="Refresh_Click" Margin="0"/>
   </Grid>
   <Grid Grid.Row="1">
    <Grid x:Name="BrowsePanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10"><Button x:Name="PlayListButton" Content="{local:Loc Ko='▶ 목록 재생', En='▶ Play list', Ja='▶ リストを再生'}" Click="PlayList_Click" DockPanel.Dock="Right" Visibility="Collapsed"/><TextBlock x:Name="PageTitle" Text="{local:Loc Ko='홈 추천', En='Home', Ja='ホーム'}" FontSize="24" FontWeight="SemiBold" DockPanel.Dock="Left"/><TextBlock x:Name="ItemCount" Text="" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
     <StackPanel Grid.Row="1">
      <Border x:Name="ChannelHeader" Background="#1B1E27" CornerRadius="8" Padding="15" Margin="0,0,0,14" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="60" Height="60" Margin="0,0,15,0" VerticalAlignment="Top"><Ellipse Fill="#2A3040"/><TextBlock Text="◉" Foreground="{StaticResource Muted}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/><controls:ThumbnailImage x:Name="ChannelHeaderAvatar" Stretch="UniformToFill"><controls:ThumbnailImage.Clip><EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/></controls:ThumbnailImage.Clip></controls:ThumbnailImage></Grid><StackPanel Grid.Column="1"><TextBlock x:Name="ChannelHeaderTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ChannelHeaderDescription" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58" Margin="0,7,0,0"/></StackPanel></Grid></Border>
      <ScrollViewer x:Name="BrowseFiltersScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12" Visibility="Collapsed" PreviewMouseWheel="BrowseFilters_PreviewMouseWheel"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Style></ScrollViewer.Resources><ItemsControl x:Name="BrowseFilterItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding}" Click="BrowseFilter_Click" Style="{StaticResource FeedFilterButtonStyle}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      <StackPanel x:Name="HistoryActions" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed"><Button Content="{local:Loc Ko='이 앱에서 본 기록', En='History in this app', Ja='このアプリの履歴'}" Click="LocalHistory_Click"/><Button Content="{local:Loc Ko='YouTube 기록 확인', En='YouTube history', Ja='YouTube の履歴'}" Click="RemoteHistory_Click"/></StackPanel>
     </StackPanel>
     <ListBox x:Name="VideoList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.ScrollChanged="Feed_ScrollChanged" HorizontalContentAlignment="Stretch">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
       <Border Tag="{Binding}" Margin="0,0,12,20" Background="#1B1E27" CornerRadius="7" ToolTip="{local:Loc Ko='오른쪽 클릭: 영상 링크 복사 / 관심 없음 / 이 채널 추천 안 함', En='Right-click: Copy video link / Not interested / Do not recommend channel', Ja='右クリック: 動画リンクをコピー / 興味なし / チャンネルをおすすめに表示しない'}">
        <Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.Tag,RelativeSource={RelativeSource Self}}"><MenuItem Header="{local:Loc Ko='영상 링크 복사', En='Copy video link', Ja='動画リンクをコピー'}" Click="CardShare_Click"><MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="video"><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers></Style></MenuItem.Style></MenuItem><Separator/><MenuItem Header="{local:Loc Ko='관심 없음', En='Not interested', Ja='興味なし'}" Tag="not_interested" IsEnabled="{Binding CanNotInterested}" Click="Recommendation_Click"/><MenuItem Header="{local:Loc Ko='이 채널 추천 안 함', En='Do not recommend channel', Ja='チャンネルをおすすめに表示しない'}" Tag="dont_recommend_channel" IsEnabled="{Binding CanDontRecommendChannel}" Click="Recommendation_Click"/></ContextMenu></Border.ContextMenu>
        <StackPanel>
         <Button Click="Video_Click" Tag="{Binding}" Padding="0" Margin="0" Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"><StackPanel><Grid Height="132" Background="#232938"><controls:ThumbnailImage Url="{Binding Thumbnail}" Stretch="UniformToFill"/><Border Background="#D0101115" CornerRadius="3" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"><TextBlock Text="{local:LocValue Path=DurationText}" FontSize="11"/></Border></Grid><TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="44" FontWeight="SemiBold" Margin="11,10,11,5"/></StackPanel></Button>
         <Button Click="Channel_Click" Tag="{Binding}" IsEnabled="{Binding CanOpenChannel}" Style="{StaticResource ChannelLinkButtonStyle}" Margin="7,0,7,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="24" Height="24" Margin="0,0,7,0"><Ellipse Fill="#2A3040"/><TextBlock Text="◉" Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/><controls:ThumbnailImage Url="{Binding ChannelThumbnail}" Stretch="UniformToFill"><controls:ThumbnailImage.Clip><EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12"/></controls:ThumbnailImage.Clip></controls:ThumbnailImage></Grid><TextBlock Grid.Column="1" Text="{local:LocValue Path=Channel, Converter={StaticResource ChannelNameConverter}}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/></Grid></Button>
         <TextBlock Text="{local:LocValue Converter={StaticResource VideoCardDetailConverter}}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="11,4,11,12"/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"><Button x:Name="MoreButton" Content="{local:Loc Ko='다음 목록 불러오기', En='Load more', Ja='さらに読み込む'}" Click="More_Click"/><TextBlock x:Name="FeedState" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></StackPanel>
     <Border x:Name="WelcomePanel" Grid.Row="2" Background="#1B1E27" Padding="32" VerticalAlignment="Top" Margin="0,20,0,0" Visibility="Collapsed"><StackPanel><TextBlock Text="{local:Loc Ko='나의 YouTube를 가볍게', En='Your YouTube, lightweight', Ja='あなたの YouTube を軽快に'}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{local:Loc Ko='설정에서 Firefox 세션 또는 쿠키 파일을 연결하면 홈 추천과 구독 목록을 볼 수 있습니다.&#10;로그인 없이도 검색어·영상 주소로 시작할 수 있어요.', En='Connect a Firefox session or cookie file in Settings to see Home and subscriptions.&#10;You can also start with a search or video URL without signing in.', Ja='設定で Firefox セッションまたは Cookie ファイルを接続すると、ホームと登録チャンネルを表示できます。&#10;ログインせずに検索語や動画 URL から始めることもできます。'}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,18,0,24"/><Button Content="{local:Loc Ko='로그인 연결 설정', En='Set up sign-in', Ja='ログイン接続を設定'}" Tag="settings" Click="Nav_Click" HorizontalAlignment="Left"/></StackPanel></Border>
    </Grid>
    <Grid x:Name="PlayerPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel x:Name="PlayerHeading" Margin="0,0,0,14">
      <Button Content="{local:Loc Ko='← 목록으로', En='← Back to list', Ja='← 一覧に戻る'}" Click="Back_Click" DockPanel.Dock="Left"/>
      <Button x:Name="ShowSidePanelButton" Click="ShowSidePanel_Click" DockPanel.Dock="Right" Visibility="Collapsed" Margin="8,0,0,0" Style="{StaticResource PlayerIconButtonStyle}" ToolTip="{local:Loc Ko='추천 · 댓글 패널 펼치기', En='Show recommendations and comments', Ja='おすすめ・コメント パネルを表示'}" AutomationProperties.Name="{local:Loc Ko='추천 및 댓글 패널 펼치기', En='Show recommendations and comments panel', Ja='おすすめとコメントのパネルを表示'}"><Path Data="M13,2 L5,10 13,18 M18,2 L18,18" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Stretch="Uniform"/></Button>
      <Button x:Name="ShowPlaybackControlsButton" Click="ShowPlaybackControls_Click" DockPanel.Dock="Right" Visibility="Collapsed" Margin="8,0,0,0" Style="{StaticResource PlayerIconButtonStyle}" ToolTip="{local:Loc Ko='재생 조작 패널 펼치기', En='Show playback controls', Ja='再生コントロールを表示'}" AutomationProperties.Name="{local:Loc Ko='재생 조작 패널 펼치기', En='Show playback controls', Ja='再生コントロールを表示'}"><Path Data="M2,8 L10,2 18,8 M2,13 L18,13 M5,18 L5,10 M10,18 L10,13 M15,18 L15,10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/></Button>
      <TextBlock x:Name="LiveState" DockPanel.Dock="Right" Visibility="Collapsed" Foreground="{StaticResource Accent}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="180" Margin="8,0,0,0"/>
      <Button x:Name="PlayingTitleButton" Click="PlayingTitle_Click" Background="Transparent" Padding="6,4" Margin="4,0,0,0" HorizontalContentAlignment="Stretch" ToolTip="{local:Loc Ko='영상 설명 보기 / 닫기', En='Show / hide video description', Ja='動画の説明を表示 / 閉じる'}"><TextBlock x:Name="PlayingTitle" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"/></Button>
     </DockPanel>
     <Popup x:Name="DescriptionPopup" PlacementTarget="{Binding ElementName=PlayingTitleButton}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True"><Border Width="620" MaxWidth="620" MaxHeight="420" Background="#242936" BorderBrush="#465169" BorderThickness="1" CornerRadius="8" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button x:Name="DescriptionCloseButton" Content="{local:Loc Ko='닫기 ×', En='Close ×', Ja='閉じる ×'}" Click="DescriptionClose_Click" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="9,5"/><TextBlock Text="{local:Loc Ko='영상 설명', En='Video description', Ja='動画の説明'}" Foreground="#F0F2F8" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ScrollViewer x:Name="DescriptionScroll" Grid.Row="1" MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBox x:Name="DescriptionText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" Foreground="#F0F2F8" BorderThickness="0" Padding="0" Margin="0" FontSize="13" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Text="{local:Loc Ko='설명을 불러오는 중입니다…', En='Loading description…', Ja='説明を読み込み中…'}"/></ScrollViewer></Grid></Border></Popup>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="CommentColumn" Width="360"/></Grid.ColumnDefinitions>
       <Grid x:Name="VideoColumn"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border x:Name="VideoSurface" Background="Black" MinHeight="160" PreviewMouseLeftButtonDown="VideoSurface_Down"><playback:MpvHost x:Name="VideoHost"/></Border>
       <Border x:Name="PlaybackControlsTray" Grid.Row="1" ClipToBounds="True"><StackPanel x:Name="PlaybackControlsContent" Margin="0,0,0,4">
