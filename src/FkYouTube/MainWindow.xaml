     <TextBlock Text="{local:Loc Ko='시청 기록', En='Watch history', Ja='視聴履歴'}" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="HistorySyncCheck" Content="{local:Loc Ko='YouTube 계정에 시청 기록 전송', En='Send watch history to my YouTube account', Ja='YouTube アカウントに再生履歴を送信'}" Checked="SyncSetting_Changed" Unchecked="SyncSetting_Changed"/>
     <TextBlock Text="{local:Loc Ko='기본은 꺼짐입니다. 끄면 이 앱에서 본 영상이 YouTube 시청 기록에 전송되지 않지만, 일반 모드의 로컬 이어보기는 유지됩니다. 선택은 앱 재시작·계정 변경 후에도 저장됩니다. 시크릿 모드는 선택을 바꾸지 않고 전송만 차단합니다. 비공식 계정 연동에는 서비스 정책 및 계정 접근 제한 위험이 있습니다.', En='Off by default. When off, videos watched here are not sent to YouTube watch history; local resume positions in normal mode are kept. Your choice persists across app restarts and account changes. Incognito blocks sending without changing your preference. Unofficial account access carries service-policy and account-access restriction risks.', Ja='初期設定はオフです。オフの場合、このアプリで見た動画は YouTube の再生履歴に送信されませんが、通常モードのローカル再開位置は保持されます。選択は再起動やアカウント変更後も保存されます。シークレットモードは選択を変えずに送信だけを停止します。非公式のアカウント連携には、サービスの規約やアカウントのアクセス制限に関するリスクがあります。'}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
     <TextBlock x:Name="HistorySyncMigrationNotice" Visibility="Collapsed" Text="{local:Loc Ko='이전 기본 설정으로 켜져 있었을 수 있어 이번에 한 번만 전송을 껐습니다. 필요한 경우 위 설정을 직접 켜 주세요.', En='Sending was turned off once because the previous setting may have been enabled by default. Enable it above if you want this feature.', Ja='以前の初期設定で有効になっていた可能性があるため、今回だけ送信をオフにしました。必要な場合は上の設定をオンにしてください。'}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <TextBlock Text="{local:Loc Ko='켠 이후 실제 재생 30초 또는 짧은 영상의 80% 이후에 한 번 전송을 시도합니다. YouTube에는 완주로 표시될 수 있습니다. 정확한 이어보기 위치는 이 앱에 저장되며, 전송 성공이 계정 반영을 보장하지는 않습니다.', En='One sending attempt after 30 seconds of playback with this enabled, or 80% of a short video. YouTube may mark it as fully watched. Exact playback positions are saved in this app; successful sending does not guarantee an account update.', Ja='オンにしてから 30 秒、または短い動画の 80% を再生すると一度だけ送信を試みます。YouTube では視聴完了と表示される場合があります。正確な再生位置はこのアプリに保存され、送信の成功はアカウントへの反映を保証しません。'}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <TextBlock Text="{local:Loc Ko='전송 대기 기록은 앱 데이터베이스에 저장됩니다. 정상 재시작 시 전송 설정과 계정이 유효하면 한 번도 전송을 시도하지 않은 대기 기록만 계속 전송합니다. 실패했거나 전송 중 중단·결과 불명인 기록은 자동 재시도하지 않습니다.', En='Pending records are saved in the app database. After a normal restart, only pending records never attempted continue sending when the preference and account are valid. Failed, interrupted, or uncertain results are never retried automatically.', Ja='送信待ちの履歴はアプリのデータベースに保存されます。通常の再起動後は、送信設定とアカウントが有効な場合に、一度も送信を試みていない待機中の履歴だけ送信を続けます。失敗・中断・結果不明の履歴は自動再試行しません。'}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <TextBlock Text="{local:Loc Ko='전송 끄기·계정 변경·시크릿 모드 전환으로 보류된 미전송 기록은 직접 재개할 때까지 유지됩니다. 재개는 현재 계정·채널의 한 번도 보내지 않은 보류 기록에만 적용되며, 실패·결과 불명 기록은 포함하지 않습니다.', En='Unsent records held after turning sending off, changing accounts, or switching incognito stay held until you resume them. Resume applies only to never-sent held records for the current account and channel, excluding failed or uncertain results.', Ja='送信オフ・アカウント変更・シークレットモードへの切り替えで保留された未送信の履歴は、手動で再開するまで保留されます。再開の対象は現在のアカウント・チャンネルの一度も送信していない保留履歴だけで、失敗・結果不明の履歴は含みません。'}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <TextBlock x:Name="HistoryOutboxStateText" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,10,0,0"/>
     <WrapPanel Margin="0,8,0,0"><Button x:Name="HistoryOutboxResumeButton" Content="{local:Loc Ko='보류 기록 전송 재개', En='Resume held records', Ja='保留中の履歴の送信を再開'}" Click="HistoryOutboxResume_Click" IsEnabled="False"/><Button Content="{local:Loc Ko='대기 상태 새로고침', En='Refresh pending status', Ja='送信待ちの状態を更新'}" Click="HistoryOutboxRefresh_Click"/></WrapPanel>
     <TextBlock Text="{local:Loc Ko='목록 표시', En='List display', Ja='一覧の表示'}" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,0"/><CheckBox x:Name="HideMembersCheck" Content="{local:Loc Ko='멤버십 전용 영상 숨기기', En='Hide members-only videos', Ja='メンバー限定動画を隠す'}" Checked="HideMembers_Changed" Unchecked="HideMembers_Changed"/><TextBlock Text="{local:Loc Ko='YouTube가 목록에서 멤버십 전용으로 표시한 영상을 거릅니다. 표시 정보가 없는 영상은 재생할 때 확인될 수 있습니다.', En='Filter videos marked as members-only in YouTube lists. Videos without that label may only be identified during playback.', Ja='YouTube の一覧でメンバー限定と表示された動画を除外します。表示情報がない動画は再生時に判明する場合があります。'}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock Text="{local:Loc Ko='재생목록 주소', En='Playlist URL', Ja='再生リスト URL'}" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10"/><TextBlock Text="{local:Loc Ko='계정의 재생목록 목록을 가져오지 못하는 경우 특정 재생목록 주소로 바로 열 수 있습니다.', En='Open a playlist URL directly if the account playlist list cannot be loaded.', Ja='アカウントの再生リスト一覧を取得できない場合は、再生リスト URL を直接開けます。'}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/><DockPanel><Button Content="{local:Loc Ko='저장 / 열기', En='Save / Open', Ja='保存 / 開く'}" Click="PlaylistUrl_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="PlaylistUrlBox" MinWidth="380"/></DockPanel>
     <TextBlock Text="{local:Loc Ko='동봉 도구', En='Bundled tools', Ja='同梱ツール'}" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10"/><TextBlock x:Name="ToolState" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><Button Content="{local:Loc Ko='진단 폴더 열기', En='Open diagnostics folder', Ja='診断フォルダーを開く'}" Click="OpenData_Click" HorizontalAlignment="Left" Margin="0,12,0,24"/>
     <Border Background="#27251F" BorderBrush="#6F5B38" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,24"><StackPanel>
      <TextBlock Text="{local:Loc Ko='실험적 도구 업데이트', En='Experimental tool updates', Ja='試験的なツール更新'}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="{local:Loc Ko='현재 재생이 정상이라면 업데이트하지 마세요. 실험적 업데이트는 재생·목록·댓글·자막을 망가뜨릴 수 있습니다.', En='If playback currently works normally, do not update. Experimental updates may break playback, lists, comments, or subtitles.', Ja='現在正常に再生できる場合は更新しないでください。試験的な更新により、再生・一覧・コメント・字幕が動作しなくなる場合があります。'}" Foreground="#E8D5AC" TextWrapping="Wrap" Margin="0,8,0,12"/>
      <WrapPanel>
       <ComboBox x:Name="ToolUpdateChoice" SelectedIndex="0" MinWidth="110" Margin="0,0,8,8" VerticalAlignment="Center" AutomationProperties.Name="{local:Loc Ko='업데이트할 도구', En='Tool to update', Ja='更新するツール'}"><ComboBoxItem Content="yt-dlp" Tag="yt-dlp"/><ComboBoxItem Content="Deno" Tag="deno"/></ComboBox>
       <Button x:Name="ToolCheckButton" Content="{local:Loc Ko='업데이트 확인', En='Check for update', Ja='更新を確認'}" Click="ToolCheck_Click" Margin="0,0,8,8"/>
       <Button x:Name="ToolDownloadButton" Content="{local:Loc Ko='다운로드 · 적용', En='Download · Apply', Ja='ダウンロード・適用'}" Click="ToolDownload_Click" Margin="0,0,8,8"/>
       <Button x:Name="ToolCancelButton" Content="{local:Loc Ko='취소', En='Cancel', Ja='キャンセル'}" Click="ToolCancel_Click" Margin="0,0,8,8"/>
      </WrapPanel>
      <WrapPanel>
       <Button x:Name="ToolRollbackButton" Content="{local:Loc Ko='이전 버전으로 복구', En='Restore previous version', Ja='前のバージョンに戻す'}" Click="ToolRollback_Click" Margin="0,0,8,8"/>
       <Button x:Name="ToolBundledButton" Content="{local:Loc Ko='동봉 버전 사용', En='Use bundled version', Ja='同梱バージョンを使う'}" Click="ToolBundled_Click" Margin="0,0,8,8"/>
      </WrapPanel>
      <TextBlock x:Name="ToolUpdateState" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Grid>
   <StackPanel x:Name="StatusPanel" Grid.Row="2"><WrapPanel x:Name="DownloadStrip" Visibility="Collapsed" Margin="0,8,0,0"><Button x:Name="CancelDownloadButton" Content="{local:Loc Ko='다운로드 취소', En='Cancel download', Ja='ダウンロードをキャンセル'}" Click="CancelDownload_Click" Visibility="Collapsed"/><TextBlock x:Name="DownloadState" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" Margin="0,0,8,0"/></WrapPanel><TextBlock x:Name="StatusText" Text="{local:Loc Ko='준비됨', En='Ready', Ja='準備完了'}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"/></StackPanel>
  </Grid>
 </Grid>
</Window>
